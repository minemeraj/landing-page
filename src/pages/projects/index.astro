---
import { getEmDashCollection, getSeoMeta, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

// Get site settings for SEO
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(await getSiteSettings());

// SEO metadata for all projects page
const seo = getSeoMeta(
	{ data: { title: "All Projects", excerpt: "Browse all weekend projects" } },
	{
		siteTitle,
		siteUrl: Astro.url.origin,
		path: "/projects",
		defaultOgImage: undefined,
	}
);

// Project categories (defined as a field option, not a taxonomy)
const CATEGORIES = [
	{ slug: "web", label: "Web Application" },
	{ slug: "mobile", label: "Mobile App" },
	{ slug: "cli", label: "CLI Tool" },
	{ slug: "library", label: "Library/Package" },
	{ slug: "api", label: "API/Backend" },
	{ slug: "design", label: "Design/UX" },
	{ slug: "other", label: "Other" },
];

const categoryParam = Astro.url.searchParams.get("category");
const filter = categoryParam ? { where: { category: categoryParam } } : {};

const { entries: projects, cacheHint } = await getEmDashCollection("projects", {
	orderBy: { published_at: "desc" },
	...filter,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base
	title={seo.title}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="website"
>
	<div class="projects-page">
		<header class="page-header">
			<h1 class="page-title">All Projects</h1>
			<p class="page-description">
				{projects.length} {projects.length === 1 ? "project" : "projects"}
			</p>
		</header>

		<!-- Category Filter -->
		<div class="projects-filter">
			<button 
				class={`filter-btn ${!categoryParam ? 'active' : ''}`}
				onclick="window.location.search = 'category='"
			>
				All
			</button>
			{CATEGORIES.map((category) => (
				<button 
					class={`filter-btn ${categoryParam === category.slug ? 'active' : ''}`}
					onclick={`window.location.search = 'category=${category.slug}'`}
				>
					{category.label}
				</button>
			))}
		</div>

		{
			projects.length === 0 ? (
				<p class="empty">No projects found.</p>
			) : (
				<div class="projects-grid">
					{projects.map((project, index) => (
						<div class="project-card-wrapper" data-reveal style={`--reveal-delay: ${index * 0.1}s`}>
							<ProjectCard
								title={project.data.title}
								description={project.data.description}
								featuredImage={project.data.featured_image}
								href={`/projects/${project.id}`}
								category={project.data.category}
								githubUrl={project.data.github_url}
								liveUrl={project.data.live_url}
							/>
						</div>
					))}
				</div>
			)
		}
	</div>
</Base>

<style>
	.projects-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		text-align: center;
		margin-bottom: var(--spacing-8);
	}

	.page-title {
		font-size: clamp(1.75rem, 4vw, var(--font-size-3xl));
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.page-description {
		font-size: var(--font-size-lg);
		color: var(--color-text-secondary);
	}

	.projects-filter {
		display: flex;
		gap: var(--spacing-2);
		justify-content: center;
		flex-wrap: wrap;
		margin-bottom: var(--spacing-12);
	}

	.filter-btn {
		padding: var(--spacing-2) var(--spacing-4);
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-text-secondary);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		cursor: pointer;
		transition: all 0.2s;
	}

	.filter-btn:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
	}

	.filter-btn.active {
		background: var(--color-brand);
		color: var(--color-on-brand);
		border-color: var(--color-brand);
	}

	.empty {
		text-align: center;
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	.project-card-wrapper {
		height: 100%;
		transition: transform 0.3s ease;
	}

	.project-card-wrapper:hover {
		transform: translateY(-8px);
	}

	.project-card-wrapper :global(.project-card) {
		height: 100%;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: var(--spacing-8);
	}

	@media (max-width: 900px) {
		.projects-page {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.page-title {
			font-size: var(--font-size-2xl);
		}

		.projects-grid {
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		}
	}

	@media (max-width: 600px) {
		.projects-filter {
			gap: var(--spacing-1);
		}

		.filter-btn {
			padding: var(--spacing-2) var(--spacing-3);
			font-size: var(--font-size-xs);
		}

		.projects-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
