---
import { getEmDashCollection, getTaxonomyTerms, getTermsForEntries, getSeoMeta, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

// Get site settings for SEO
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(await getSiteSettings());

// SEO metadata for all posts page
const seo = getSeoMeta(
	{ data: { title: "All Posts", excerpt: "Browse all blog posts" } },
	{
		siteTitle,
		siteUrl: Astro.url.origin,
		path: "/posts",
		defaultOgImage: undefined,
	}
);

// Get all post categories for filtering
const categories = await getTaxonomyTerms("posts", "category");

const categoryParam = Astro.url.searchParams.get("category");
// Build query filters
const filter: Record<string, unknown> = {};
if (categoryParam) {
	filter.terms = { category: categoryParam };
}

// Sort in the database rather than in JS — lets the DB use its index on
// published_at and avoids a full-table scan on the client.
const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	...filter,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Single batched query for tags across all posts
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);

const postsWithTags = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
	bylines: post.data.bylines ?? [],
}));
---

<Base
	title={seo.title}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="website"
>
	<div class="posts-page">
		<header class="page-header">
			<h1 class="page-title">All Articles</h1>
			<p class="page-description">
				{posts.length} {posts.length === 1 ? "article" : "articles"}
			</p>
		</header>

		<!-- Category Filter -->
		<div class="posts-filter">
			<button 
				class={`filter-btn ${!categoryParam ? 'active' : ''}`}
				onclick="window.location.search = 'category='"
			>
				All
			</button>
			{categories.map((category) => (
				<button 
					class={`filter-btn ${categoryParam === category.slug ? 'active' : ''}`}
					onclick={`window.location.search = 'category=${category.slug}'`}
				>
					{category.label}
				</button>
			))}
		</div>

		{
			posts.length === 0 ? (
				<p class="empty">No posts found.</p>
			) : (
				<div class="posts-grid">
					{postsWithTags.map(({ post, tags, bylines }, index) => (
						<div class="post-card-wrapper" data-reveal style={`--reveal-delay: ${index * 0.1}s`}>
							<PostCard
								title={post.data.title}
								excerpt={post.data.excerpt}
								featuredImage={post.data.featured_image}
								href={`/posts/${post.id}`}
								date={post.data.publishedAt ?? undefined}
								readingTime={getReadingTime(post.data.content)}
								tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
								bylines={bylines}
							/>
						</div>
					))}
				</div>
			)
		}
	</div>
</Base>

<style>
	.posts-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		text-align: center;
		margin-bottom: var(--spacing-8);
	}

	.page-title {
		font-size: clamp(1.75rem, 4vw, var(--font-size-3xl));
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.page-description {
		font-size: var(--font-size-lg);
		color: var(--color-text-secondary);
	}

	.posts-filter {
		display: flex;
		gap: var(--spacing-2);
		justify-content: center;
		flex-wrap: wrap;
		margin-bottom: var(--spacing-12);
	}

	.filter-btn {
		padding: var(--spacing-2) var(--spacing-4);
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-text-secondary);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		cursor: pointer;
		transition: all 0.2s;
	}

	.filter-btn:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
	}

	.filter-btn.active {
		background: var(--color-brand);
		color: var(--color-on-brand);
		border-color: var(--color-brand);
	}

	.empty {
		text-align: center;
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	.post-card-wrapper {
		height: 100%;
		transition: transform 0.3s ease;
	}

	.post-card-wrapper:hover {
		transform: translateY(-8px);
	}

	.post-card-wrapper :global(.post-card) {
		height: 100%;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: var(--spacing-8);
	}

	@media (max-width: 900px) {
		.posts-page {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.page-title {
			font-size: var(--font-size-2xl);
		}

		.posts-grid {
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		}
	}

	@media (max-width: 600px) {
		.posts-filter {
			gap: var(--spacing-1);
		}

		.filter-btn {
			padding: var(--spacing-2) var(--spacing-3);
			font-size: var(--font-size-xs);
		}

		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
