---
import { getEmDashCollection, getTermsForEntries, getSiteSettings, getSeoMeta } from "emdash";
import Base from "../layouts/Base.astro";
import { getReadingTime } from "../utils/reading-time";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import FeaturedProjects from "../components/home/FeaturedProjects.astro";
import LatestPosts from "../components/home/LatestPosts.astro";

const FEATURED_PROJECTS_LIMIT = 3;
const LATEST_POSTS_LIMIT = 4;

const [{ entries: projects }, { entries: posts }, settings] = await Promise.all([
	getEmDashCollection("projects", {
		orderBy: { published_at: "desc" },
		limit: 12,
	}),
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: LATEST_POSTS_LIMIT,
	}),
	getSiteSettings(),
]);

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

// SEO metadata for home page
const seo = getSeoMeta(
	{ data: { title: siteTitle, excerpt: siteTagline } },
	{
		siteTitle,
		siteUrl: Astro.url.origin,
		path: Astro.url.pathname.replace(/\/$/, ""),
		defaultOgImage: undefined,
	}
);

// Prefer projects explicitly marked featured; fall back to the most recent
const featuredProjects = projects.filter((p) => p.data.featured).slice(0, FEATURED_PROJECTS_LIMIT);
const projectsForHome =
	featuredProjects.length > 0 ? featuredProjects : projects.slice(0, FEATURED_PROJECTS_LIMIT);

// Single batched query for tags across posts
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);

const postsForHome = posts.map((post) => ({
	id: post.id,
	title: post.data.title ?? "Untitled",
	excerpt: post.data.excerpt,
	featuredImage: post.data.featured_image,
	date: post.data.publishedAt ?? undefined,
	readingTime: getReadingTime(post.data.content),
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({ slug: t.slug, label: t.label })),
	bylines: post.data.bylines ?? [],
}));

const projectsData = projectsForHome.map((project) => ({
	id: project.id,
	title: project.data.title ?? "Untitled",
	description: project.data.description,
	featuredImage: project.data.featured_image,
	category: project.data.category,
	githubUrl: project.data.github_url,
	liveUrl: project.data.live_url,
}));
---

<Base
	title={seo.title}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="website"
>
	<!-- Hero Section -->
	<section class="hero-section">
		<div class="floating-shape shape-1"></div>
		<div class="floating-shape shape-2"></div>
		<div class="floating-shape shape-3"></div>
		<div class="hero-content">
			<h1 class="hero-title">
				Creative coding <br />
				<span class="hero-title-gradient">beyond the 9-to-5</span>
			</h1>
			<p class="hero-subtitle">
				A community for weekend hackers and side-project builders. Show off your builds, share your journey, and discover inspiration for your next project.
			</p>
			<div class="hero-actions">
				<a href="/projects" class="btn btn-primary">Explore Projects</a>
				<a href="/posts" class="btn btn-secondary">Read the Blog</a>
			</div>
		</div>
	</section>

	<!-- Featured Projects Section -->
	{projectsData.length > 0 && <FeaturedProjects projects={projectsData} viewAllHref="/projects" />}

	<!-- Featured Posts Section -->
	{postsForHome.length > 0 && <LatestPosts posts={postsForHome} viewAllHref="/posts" />}

	<!-- About Section -->
	<section class="about-section">
		<div class="section-container">
			<header class="section-header">
				<h2 class="section-heading">About The Weekend Projects</h2>
				<p class="section-subtitle">
					A community-driven space for developers who code for fun outside of work hours.
				</p>
			</header>
			<div class="about-content">
				<p>
					The Weekend Projects is a place for creative coders, hobbyists, and side-project enthusiasts to share their work, learn from each other, and find inspiration for their next build.
				</p>
				<p>
					We believe that programming should be fun, not just a job. Whether you're building a simple tool to automate your workflow, creating a game just for fun, or experimenting with new technologies - this is your home.
				</p>
				<div class="about-features">
					<div class="feature-item">
						<h4>Project Showcase</h4>
						<p>Display your weekend builds with screenshots, tech stack, and live demos.</p>
					</div>
					<div class="feature-item">
						<h4>Community Blog</h4>
						<p>Share your journey, lessons learned, and technical insights with fellow makers.</p>
					</div>
					<div class="feature-item">
						<h4>No Pressure</h4>
						<p>Zero engagement metrics, no ads, just pure creative coding for the joy of it.</p>
					</div>
				</div>
				<a href="/pages/about" class="btn btn-secondary">Learn more about us</a>
			</div>
		</div>
	</section>

	<!-- Newsletter Section -->
	<section class="newsletter-section">
		<div class="section-container">
			<div class="newsletter-content">
				<h2 class="newsletter-title">Stay in the loop</h2>
				<p class="newsletter-subtitle">
					Get notified when new projects are published. One email per project, no spam, unsubscribe anytime.
				</p>
				<form class="newsletter-form" action="/#newsletter" method="post">
					<div class="form-group">
						<input type="email" name="email" placeholder="Your email address" required class="form-input" />
						<button type="submit" class="btn btn-primary">Subscribe</button>
					</div>
					<p class="form-note">No spam. Unsubscribe anytime.</p>
				</form>
			</div>
		</div>
	</section>
</Base>

<style>
	.hero-section {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 8rem 2rem 4rem;
		position: relative;
		overflow: hidden;
	}

	.floating-shape {
		position: absolute;
		border-radius: 50%;
		filter: blur(60px);
		opacity: 0.4;
		animation: float 10s ease-in-out infinite;
	}

	.shape-1 {
		width: 400px;
		height: 400px;
		background: var(--theme-gradient-1);
		top: 10%;
		left: 10%;
		animation-delay: 0s;
	}

	.shape-2 {
		width: 300px;
		height: 300px;
		background: var(--theme-gradient-2);
		bottom: 20%;
		right: 10%;
		animation-delay: 3s;
	}

	.shape-3 {
		width: 250px;
		height: 250px;
		background: var(--theme-gradient-3);
		top: 40%;
		right: 20%;
		animation-delay: 6s;
	}

	.hero-content {
		max-width: 800px;
		text-align: center;
		position: relative;
		z-index: 1;
	}

	.hero-title {
		font-size: 4.5rem;
		font-weight: 900;
		line-height: 1.1;
		margin-bottom: 1.5rem;
		letter-spacing: -0.02em;
	}

	.hero-title-gradient {
		background: linear-gradient(to right, var(--color-brand), var(--theme-gradient-1));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		font-size: 1.25rem;
		color: var(--color-text-secondary);
		margin-bottom: 2.5rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
	}

	.about-section {
		padding: var(--spacing-20) 0;
		background: linear-gradient(180deg, var(--color-bg-subtle) 0%, var(--color-bg) 100%);
	}

	.section-container {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-6);
	}

	.section-header {
		text-align: center;
		margin-bottom: var(--spacing-12);
	}

	.section-heading {
		font-size: clamp(1.75rem, 4vw, var(--font-size-3xl));
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.section-subtitle {
		font-size: var(--font-size-lg);
		color: var(--color-text-secondary);
		max-width: 600px;
		margin: 0 auto;
	}

	.about-content {
		max-width: 800px;
		margin: 0 auto;
		text-align: center;
	}

	.about-content p {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		margin-bottom: var(--spacing-6);
	}

	.about-features {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: var(--spacing-6);
		margin: var(--spacing-8) 0;
	}

	.feature-item h4 {
		font-size: var(--font-size-base);
		font-weight: var(--font-weight-heading);
		color: var(--color-text);
		margin-bottom: var(--spacing-2);
	}

	.feature-item p {
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	.newsletter-section {
		padding: var(--spacing-20) 0;
	}

	.newsletter-content {
		max-width: 600px;
		margin: 0 auto;
		text-align: center;
	}

	.newsletter-title {
		font-size: clamp(1.75rem, 4vw, var(--font-size-3xl));
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-4);
	}

	.newsletter-subtitle {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		margin-bottom: var(--spacing-8);
	}

	.newsletter-form {
		display: flex;
		gap: var(--spacing-4);
		justify-content: center;
		flex-wrap: wrap;
	}

	.form-group {
		display: flex;
		gap: var(--spacing-2);
		flex: 1;
		min-width: 300px;
	}

	.form-input {
		flex: 1;
		padding: var(--spacing-3) var(--spacing-4);
		font-size: var(--font-size-base);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		color: var(--color-text);
		transition: all 0.2s;
	}

	.form-input:focus {
		outline: none;
		border-color: var(--color-brand);
		box-shadow: 0 0 0 3px var(--color-brand-ring);
	}

	.form-note {
		width: 100%;
		text-align: center;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-2);
		padding: var(--spacing-3) var(--spacing-6);
		border-radius: var(--radius-lg);
		font-size: var(--font-size-base);
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s;
	}

	.btn-primary {
		background: var(--color-brand);
		color: var(--color-on-brand);
		border: none;
	}

	.btn-primary:hover {
		background: var(--color-brand-hover);
	}

	.btn-secondary {
		background: var(--color-surface);
		color: var(--color-text);
		border: 1px solid var(--color-border);
	}

	.btn-secondary:hover {
		border-color: var(--color-text-secondary);
	}

	/* Animations */
	@keyframes float {
		0%, 100% {
			transform: translate(0, 0);
		}
		33% {
			transform: translate(30px, -50px);
		}
		66% {
			transform: translate(-20px, 20px);
		}
	}

	/* Responsive */
	@media (max-width: 900px) {
		.hero-section {
			padding: 6rem 1rem 3rem;
		}

		.about-section,
		.newsletter-section {
			padding: var(--spacing-12) 0;
		}

		.section-container {
			padding: 0 var(--spacing-4);
		}
	}

	@media (max-width: 600px) {
		.hero-title {
			font-size: clamp(1.75rem, 8vw, var(--font-size-3xl));
		}
		.hero-actions {
			flex-direction: column;
			width: 100%;
		}
		.btn {
			width: 100%;
		}
		.form-group {
			flex-direction: column;
		}
		.about-features {
			grid-template-columns: 1fr;
		}
		.floating-shape {
			display: none;
		}
	}
</style>
