---
import type { MediaValue } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	title: string;
	description?: string;
	featuredImage?: MediaValue | string;
	href: string;
	category?: string;
	githubUrl?: string;
	liveUrl?: string;
}

const { title, description, featuredImage, href, category, githubUrl, liveUrl } =
	Astro.props;

const categoryLabels: Record<string, string> = {
	web: "Web Application",
	mobile: "Mobile App",
	cli: "CLI Tool",
	library: "Library/Package",
	api: "API/Backend",
	design: "Design/UX",
	other: "Other",
};
---

<article class="project-card">
	<a href={href} class="card-link">
		{
			featuredImage ? (
				<div class="card-image">
					<Image image={featuredImage} />
				</div>
			) : (
				<div class="card-placeholder" aria-hidden="true">
					<span class="card-placeholder-glyph">
						{(title?.trim()?.[0] ?? "?").toUpperCase()}
					</span>
				</div>
			)
		}
		<div class="card-body">
			{category && (
				<div class="project-tags">
					<span class="tag">{categoryLabels[category] ?? category}</span>
				</div>
			)}
			<h2 class="card-title">{title}</h2>
			{description && <p class="card-excerpt">{description}</p>}
		</div>
	</a>
	<div class="project-links">
		<a href={liveUrl || href} class="btn btn-primary">
			View Project →
		</a>
		{githubUrl && (
			<a href={githubUrl} target="_blank" rel="noopener noreferrer" class="github-link">
				GitHub
			</a>
		)}
	</div>
</article>

<style is:global>
	/*
	 * is:global + :where() together drop this block's specificity to
	 * (0,0,0) for every rule -- Astro's usual [data-astro-cid-*] scoping
	 * attribute is skipped (is:global) and :where() itself always
	 * resolves to zero specificity regardless of what's inside it. That
	 * means a theme file's plain ".project-card" (specificity 0,1,0)
	 * always wins outright, with no dependency on <link>/<style> load
	 * order.
	 *
	 * Every selector here is scoped under ".project-card" (rather than a
	 * bare ".card-body", ".card-title", etc.) because is:global removes
	 * Astro's per-component namespacing -- PostCard.astro reuses the
	 * same class names for a different layout, so without the
	 * ".project-card" prefix the two components' rules would collide
	 * globally.
	 */
	:where(.project-card) {
		display: flex;
		flex-direction: column;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		transition:
			transform var(--transition-fast),
			border-color var(--transition-fast),
			box-shadow var(--transition-fast);
	}

	:where(.project-card .card-link) {
		display: flex;
		flex: 1;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
	}

	/* Image sits flush with the card's rounded top edge; text content
	   below gets its own padding via .card-body. */
	:where(.project-card .card-image) {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--color-bg-subtle);
	}

	:where(.project-card .card-image img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	:where(.project-card .card-link:hover .card-image img) {
		transform: scale(1.03);
	}

	/* Imageless project cards get a filled, branded 16:9 banner (matching
	   the .card-image frame) instead of a flat grey box. The glyph is the
	   project title's initial. Themes may override the background to their
	   own gradient; the initial + centering stay. */
	:where(.project-card .card-placeholder) {
		aspect-ratio: 16 / 9;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(
			135deg,
			var(--color-brand) 0%,
			var(--color-brand-hover, var(--color-brand)) 100%
		);
	}

	:where(.project-card .card-placeholder-glyph) {
		font-size: clamp(2.5rem, 6vw, 4rem);
		font-weight: var(--font-weight-display);
		line-height: 1;
		color: var(--color-on-brand, #fff);
		opacity: 0.9;
		user-select: none;
	}

	:where(.project-card .card-body) {
		flex: 1;
		display: flex;
		flex-direction: column;
		padding: var(--spacing-6);
	}

	:where(.project-card .project-tags) {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-4);
	}

	:where(.project-card .tag) {
		display: inline-block;
		padding: var(--spacing-1) var(--spacing-3);
		font-size: var(--font-size-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-muted);
		background: var(--color-bg-subtle);
		border-radius: 999px;
	}

	:where(.project-card .card-title) {
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
	}

	:where(.project-card .card-link:hover .card-title) {
		color: var(--color-brand);
	}

	:where(.project-card .card-excerpt) {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	:where(.project-card .project-links) {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--spacing-3);
		margin: 0 var(--spacing-6) var(--spacing-6);
		padding-top: var(--spacing-4);
		border-top: 1px solid var(--color-border-subtle);
	}

	:where(.project-card .btn) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-2);
		padding: var(--spacing-2) var(--spacing-4);
		font-size: var(--font-size-sm);
		font-weight: 700;
		text-decoration: none;
		border-radius: 999px;
		transition:
			transform var(--transition-fast),
			box-shadow var(--transition-fast),
			background var(--transition-fast);
	}

	:where(.project-card .btn-primary) {
		background: var(--color-brand);
		color: var(--color-on-brand);
		border: none;
	}

	:where(.project-card .btn-primary:hover) {
		background: var(--color-brand-hover);
	}

	:where(.project-card .github-link) {
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	:where(.project-card .github-link:hover) {
		color: var(--color-text);
	}

	@media (max-width: 600px) {
		:where(.project-card .card-title) {
			font-size: var(--font-size-lg);
		}
	}
</style>
