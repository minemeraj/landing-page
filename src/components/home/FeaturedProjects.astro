---
import type { MediaValue } from "emdash";
import ProjectCard from "../ProjectCard.astro";

interface ProjectItem {
	id: string;
	title: string;
	description?: string;
	featuredImage?: MediaValue | string;
	category?: string;
	githubUrl?: string;
	liveUrl?: string;
}

interface Props {
	projects: ProjectItem[];
	viewAllHref?: string;
}

const { projects, viewAllHref = "/projects" } = Astro.props;
---

<section class="projects-section" id="projects">
	<div class="projects-inner">
		<header class="section-header" data-reveal>
			<div>
				<h2 class="section-heading">Featured Projects</h2>
				<p class="section-subtitle">
					Hand-picked builds from the community's weekends.
				</p>
			</div>
			<a href={viewAllHref} class="section-link">View all</a>
		</header>
		<div class="projects-grid">
			{
				projects.map((project, index) => (
					<div data-reveal style={`--reveal-delay: ${index * 0.1}s`}>
						<ProjectCard
							title={project.title}
							description={project.description}
							featuredImage={project.featuredImage}
							href={`/projects/${project.id}`}
							category={project.category}
							githubUrl={project.githubUrl}
							liveUrl={project.liveUrl}
							priority={index === 0}
						/>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.projects-section {
		padding: var(--spacing-20) var(--spacing-6);
	}

	.projects-inner {
		max-width: var(--wide-width);
		margin: 0 auto;
	}

	.section-header {
		position: relative;
		text-align: center;
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-4);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.section-heading {
		font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-3xl));
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.section-subtitle {
		font-size: var(--font-size-base);
		color: var(--color-text-secondary);
	}

	/* Positioned out of flow so it doesn't skew the centered title/
	   subtitle block off to one side. */
	.section-link {
		position: absolute;
		right: 0;
		bottom: var(--spacing-4);
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-brand);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.section-link:hover {
		color: var(--color-brand-hover);
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-8);
	}

	@media (max-width: 900px) {
		.projects-section {
			padding: var(--spacing-12) var(--spacing-4);
		}

		.projects-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.section-link {
			position: static;
			display: inline-block;
			margin-top: var(--spacing-2);
		}

		.projects-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
