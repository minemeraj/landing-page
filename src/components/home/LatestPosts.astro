---
import type { MediaValue, ContentBylineCredit } from "emdash";
import PostCard from "../PostCard.astro";

interface PostItem {
	id: string;
	title: string;
	excerpt?: string;
	featuredImage?: MediaValue | string;
	date?: Date;
	readingTime?: number;
	tags?: Array<{ slug: string; label: string }>;
	bylines?: ContentBylineCredit[];
}

interface Props {
	posts: PostItem[];
	viewAllHref?: string;
}

const { posts, viewAllHref = "/posts" } = Astro.props;
---

<section class="blog-section" id="blog">
	<div class="blog-inner">
		<header class="section-header" data-reveal>
			<div>
				<h2 class="section-heading">From the Blog</h2>
				<p class="section-subtitle">
					Notes on building, shipping, and learning on your own time.
				</p>
			</div>
			<a href={viewAllHref} class="section-link">View all</a>
		</header>
		<div class="blog-grid">
			{
				posts.map((post, index) => (
					<div data-reveal style={`--reveal-delay: ${index * 0.1}s`}>
						<PostCard
							title={post.title}
							excerpt={post.excerpt}
							featuredImage={post.featuredImage}
							href={`/posts/${post.id}`}
							date={post.date}
							readingTime={post.readingTime}
							priority={index === 0}
							tags={post.tags}
							bylines={post.bylines}
						/>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.blog-section {
		padding: var(--spacing-20) var(--spacing-6);
		background: var(--color-bg-subtle);
	}

	.blog-inner {
		max-width: var(--wide-width);
		margin: 0 auto;
	}

	.section-header {
		position: relative;
		text-align: center;
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-4);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.section-heading {
		font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-3xl));
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.section-subtitle {
		font-size: var(--font-size-base);
		color: var(--color-text-secondary);
	}

	/* Positioned out of flow so it doesn't skew the centered title/
	   subtitle block off to one side. */
	.section-link {
		position: absolute;
		right: 0;
		bottom: var(--spacing-4);
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-brand);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.section-link:hover {
		color: var(--color-brand-hover);
	}

	.blog-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-8);
	}

	@media (max-width: 900px) {
		.blog-section {
			padding: var(--spacing-12) var(--spacing-4);
		}

		.blog-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.section-link {
			position: static;
			display: inline-block;
			margin-top: var(--spacing-2);
		}

		.blog-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
