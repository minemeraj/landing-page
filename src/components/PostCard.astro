---
import type { MediaValue, ContentBylineCredit } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	title: string;
	excerpt?: string;
	featuredImage?: MediaValue | string;
	href: string;
	date?: Date;
	readingTime?: number;
	tags?: Array<{ slug: string; label: string }>;
	bylines?: ContentBylineCredit[];
	/** Eager-load this card's image instead of lazy (use for the first/above-fold card). */
	priority?: boolean;
}

const {
	title,
	excerpt,
	featuredImage,
	href,
	date,
	readingTime,
	tags,
	bylines,
	priority,
} = Astro.props;

const formattedDate = date
	? date.toLocaleDateString("en-US", {
			year: "numeric",
			month: "long",
			day: "numeric",
		})
	: null;
---

<article class="post-card">
	<a href={href} class="card-link">
		{
			featuredImage ? (
				<div class="card-image">
					<Image image={featuredImage} priority={priority} />
				</div>
			) : (
				<div class="card-placeholder" />
			)
		}
		<div class="card-body">
			<div class="post-meta">
				{
					bylines && bylines.length > 0 && (
						<>
							<div class="post-bylines">
								{bylines.slice(0, 1).map((credit) => (
									<span class="post-byline">
										{credit.byline.avatarMediaId && (
											<img
												src={`/_emdash/api/media/file/${credit.byline.avatarMediaId}`}
												alt={credit.byline.displayName}
												class="post-byline-avatar"
											/>
										)}
										<span class="post-byline-name">
											{credit.byline.displayName}
										</span>
									</span>
								))}
								{bylines.length > 1 && (
									<span
										class="byline-more"
										data-tooltip={bylines
											.slice(1)
											.map((c) => c.byline.displayName)
											.join(", ")}
										title={bylines
											.slice(1)
											.map((c) => c.byline.displayName)
											.join(", ")}
										tabindex="0"
									>
										+{bylines.length - 1}
									</span>
								)}
							</div>
							{(formattedDate || readingTime) && <span class="meta-dot" />}
						</>
					)
				}
				{formattedDate && <time>{formattedDate}</time>}
				{formattedDate && readingTime && <span class="meta-dot" />}
				{readingTime && <span>{readingTime} min read</span>}
			</div>
			<h2 class="card-title">{title}</h2>
			{excerpt && <p class="card-excerpt">{excerpt}</p>}
		</div>
	</a>
	<div class="card-actions">
		<a href={href} class="btn btn-primary">
			Read More →
		</a>
	</div>
	{
		tags && tags.length > 0 && (
			<div class="post-tags">
				{tags.slice(0, 3).map((tag) => (
					<a href={`/tag/${tag.slug}`} class="post-tag">
						{tag.label}
					</a>
				))}
			</div>
		)
	}
</article>

<style is:global>
	/*
	 * is:global + :where() together drop this block's specificity to
	 * (0,0,0) for every rule -- Astro's usual [data-astro-cid-*] scoping
	 * attribute is skipped (is:global) and :where() itself always
	 * resolves to zero specificity regardless of what's inside it. That
	 * means a theme file's plain ".post-card" (specificity 0,1,0) always
	 * wins outright, with no dependency on <link>/<style> load order.
	 *
	 * Every selector here is scoped under ".post-card" (rather than a
	 * bare ".card-body", ".card-title", etc.) because is:global removes
	 * Astro's per-component namespacing -- ProjectCard.astro reuses the
	 * same class names for a different layout, so without the ".post-
	 * card" prefix the two components' rules would collide globally.
	 */
	:where(.post-card) {
		display: flex;
		flex-direction: column;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		transition:
			transform var(--transition-fast),
			border-color var(--transition-fast),
			box-shadow var(--transition-fast);
	}

	:where(.post-card .card-link) {
		display: flex;
		flex: 1;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
	}

	/* Image sits flush with the card's rounded top edge; text content
	   below gets its own padding via .card-body. */
	:where(.post-card .card-image) {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--color-bg-subtle);
	}

	:where(.post-card .card-image img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	:where(.post-card .card-link:hover .card-image img) {
		transform: scale(1.03);
	}

	:where(.post-card .card-placeholder) {
		aspect-ratio: 16 / 9;
		background: var(--color-bg-subtle);
	}

	:where(.post-card .card-body) {
		flex: 1;
		padding: var(--spacing-6) var(--spacing-6) 0;
	}

	:where(.post-card .post-meta) {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		column-gap: var(--spacing-3);
		row-gap: 0;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		margin-bottom: var(--spacing-2);
	}

	:where(.post-card .post-meta time),
	:where(.post-card .post-meta span:not(.meta-dot)) {
		white-space: nowrap;
	}

	:where(.post-card .meta-dot) {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--color-muted);
	}

	/* Byline avatar + multi-author tooltip */
	:where(.post-card .post-bylines) {
		display: flex;
		align-items: center;
		gap: 2px;
		white-space: nowrap;
	}

	:where(.post-card .post-byline) {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-1);
	}

	:where(.post-card .post-byline-avatar) {
		width: var(--avatar-size-xs);
		height: var(--avatar-size-xs);
		border-radius: 50%;
		object-fit: cover;
	}

	:where(.post-card .post-byline-name) {
		font-weight: 500;
		color: var(--color-text-secondary);
	}

	:where(.post-card .byline-more) {
		position: relative;
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		margin-left: 2px;
		cursor: default;
		border-radius: var(--radius);
		outline-offset: 2px;
	}

	:where(.post-card .byline-more:focus-visible) {
		outline: 2px solid var(--color-brand);
	}

	:where(.post-card .byline-more[data-tooltip]:hover)::after,
	:where(.post-card .byline-more[data-tooltip]:focus-visible)::after {
		content: attr(data-tooltip);
		position: absolute;
		bottom: calc(100% + 6px);
		left: 50%;
		transform: translateX(-50%);
		white-space: nowrap;
		background: var(--color-text);
		color: var(--color-bg);
		font-size: var(--font-size-xs);
		font-weight: 400;
		padding: var(--spacing-1) var(--spacing-2);
		border-radius: var(--radius);
		pointer-events: none;
		z-index: 10;
	}

	:where(.post-card .card-title) {
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
	}

	:where(.post-card .card-link:hover .card-title) {
		color: var(--color-brand);
	}

	:where(.post-card .card-excerpt) {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	:where(.post-card .card-actions) {
		padding: var(--spacing-6) var(--spacing-6) 0;
	}

	:where(.post-card .btn) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-2);
		padding: var(--spacing-2) var(--spacing-4);
		font-size: var(--font-size-sm);
		font-weight: 700;
		text-decoration: none;
		border-radius: 999px;
		transition:
			transform var(--transition-fast),
			box-shadow var(--transition-fast),
			background var(--transition-fast);
	}

	:where(.post-card .btn-primary) {
		background: var(--color-brand);
		color: var(--color-on-brand);
		border: none;
	}

	:where(.post-card .btn-primary:hover) {
		background: var(--color-brand-hover);
	}

	:where(.post-card .post-tags) {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		padding: var(--spacing-4) var(--spacing-6) var(--spacing-6);
	}

	:where(.post-card .post-tag) {
		display: inline-block;
		padding: var(--tag-padding-y) var(--spacing-2);
		font-size: var(--font-size-xs);
		color: var(--color-text-secondary);
		background: var(--color-bg-subtle);
		border-radius: var(--radius);
		text-decoration: none;
		transition:
			color var(--transition-fast),
			background var(--transition-fast);
	}

	:where(.post-card .post-tag:hover) {
		color: var(--color-text);
		background: var(--color-border);
	}

	/* When there are no tags, .card-actions is the last child and needs
	   its own bottom padding to match .card-body's spacing rhythm. */
	:where(.post-card:not(:has(.post-tags)) .card-actions) {
		padding-bottom: var(--spacing-6);
	}
</style>
