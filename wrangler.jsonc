{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "landing-page",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "landing-page-db","database_id": "9e7ff73d-1f1e-4dab-a2b6-e45595762876",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "landing-page-media","preview_bucket_name": "landing-page-media",
		},
		// Bucket the @emdash/rag (native) AI Search backend writes page files into;
		// the AI Search instance crawls this bucket. Create it before deploying:
		//   npx wrangler r2 bucket create emdash-rag-content
		{
			"binding": "R2",
			"bucket_name": "emdash-rag-content",
		},
	],
	// Workers AI — used by @emdash/rag (native) for chat generation. Tokenless.
	"ai": {
		"binding": "AI",
	},
	// Cloudflare AI Search (formerly AutoRAG) namespace binding for @emdash/rag
	// (native). The plugin calls AI_SEARCH.get(<instance name from settings>).
	// Create the AI Search instance in the dashboard (Compute & AI → AI Search)
	// pointed at the emdash-rag-content R2 bucket before deploying.
	"ai_search_namespaces": [
		{
			"binding": "AI_SEARCH",
			"namespace": "default",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": ["* * * * *"],
	},
}
